resources:
  pipelines:
    data_pipeline:
      name: ${bundle.target}-{{ .input_project_name }}-data-pipeline
      catalog: ${var.catalog}
      target: ${var.schema}
      libraries:
        - notebook:
            path: ../src/components/retriever/data_pipeline.py
      configuration:
        catalog: ${var.catalog}
        schema: ${var.schema}
      channel: PREVIEW
      development: true
{{ if (eq .input_enable_cost_tags "yes") }}      # Usage tracking: pipeline tags are forwarded to pipeline clusters and billing.
      # If you switch to `serverless: true`, also add
      # `budget_policy_id: ${var.usage_policy_id}`. A job-triggered pipeline doesn't
      # inherit the job's policy, and in development mode policy tag changes take
      # up to 24 hours to apply (see docs/usage-tracking.md).
      tags:
        project: {{ .input_project_name }}
        environment: ${bundle.target}
{{ end }}